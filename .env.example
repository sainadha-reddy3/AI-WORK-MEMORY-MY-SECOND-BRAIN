# ==========================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# ==========================================

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=awm_memory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full connection string used by the backend.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://your_db_user:your_db_password@postgres:5432/awm_memory

ENVIRONMENT=development

# ---- AI provider ----
# local  — embeddings run inside the container. No setup, no external
#          service. This is the default and works on any machine.
# ollama — requires a reachable Ollama instance (see OLLAMA_URL).
# mock   — rule-based only, used by tests.
AI_PROVIDER=local

# Only used when AI_PROVIDER=ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text